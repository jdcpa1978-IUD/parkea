@startuml CasosUso_GestionCeldas
left to right direction
skinparam packageStyle rectangle

actor "Usuario autenticado" as Usuario
actor "Administrador" as Admin
actor "Operador" as Operador
actor "Cliente" as Cliente
Admin --|> Usuario
Operador --|> Usuario
Cliente --|> Usuario

rectangle "Sistema PARKEA - Gestión de celdas" {
  usecase "Consultar mapa\nde celdas" as Mapa
  usecase "Ver detalle de celda" as Detalle
  usecase "Registrar celda" as Crear
  usecase "Cambiar a\nmantenimiento" as Mantener
  usecase "Habilitar celda" as Habilitar
  usecase "Validar código único\ny tipo de vehículo" as Validar
  usecase "Registrar entrada" as Entrada
  usecase "Validar disponibilidad\ny compatibilidad" as ValidarDisponibilidad
  usecase "Asignar celda al ingreso" as Asignar
  usecase "Registrar salida" as Salida
  usecase "Actualizar celda al finalizar\nla salida" as Liberar
}

Usuario --> Mapa
Detalle .> Mapa : <<extend>>\n[selecciona una celda]
Admin --> Crear
Admin --> Mantener
Admin --> Habilitar
Admin --> Entrada
Admin --> Salida
Operador --> Entrada
Operador --> Salida
Crear .> Validar : <<include>>
Entrada .> ValidarDisponibilidad : <<include>>
Entrada .> Asignar : <<include>>
Salida .> Liberar : <<include>>

note right of Mapa
La consulta es de solo lectura.
No asigna, ocupa ni libera celdas.
end note

note right of Asignar
Solo el caso de uso de entrada
asigna una celda disponible y
compatible como OCUPADA.
end note

note bottom of Liberar
La salida libera una celda normal.
Si se programó mantenimiento durante
la ocupación, permanece en MANTENIMIENTO.
end note

note bottom of Mantener
Una celda ocupada puede programarse
para mantenimiento al registrar su salida.
end note
@enduml
